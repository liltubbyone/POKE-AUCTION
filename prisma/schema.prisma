generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String        @id @default(cuid())
  email             String        @unique
  name              String?
  password          String
  isAdmin           Boolean       @default(false)
  address           String?
  paymentInfo       String?
  stripeCustomerId  String?
  balance           Float         @default(0)
  createdAt         DateTime      @default(now())
  spots                 AuctionSpot[]
  dailySpins            DailySpin[]
  wordSearchCompletions WordSearchCompletion[]
  storeOrders           StoreOrder[]
  passwordResetToken String?
  passwordResetExpiry DateTime?
}

model InventoryItem {
  id           String        @id @default(cuid())
  name         String
  tier         String
  qty          Int
  cost         Float
  resellMin    Float
  resellMax    Float
  note         String?
  imageUrl     String?
  sku          String?
  gtin         String?
  shippingCost Float         @default(10.0)
  forSale      Boolean       @default(false)
  storePrice   Float?
  auctionItems    AuctionItem[]
  storeOrderItems StoreOrderItem[]
}

model Auction {
  id          String        @id @default(cuid())
  name        String
  description String?
  status      String        @default("active")
  category    String        @default("raffle")
  spotPrice   Float
  totalSpots  Int
  spinSeed     String?
  wheelTheme   String        @default("cosmic")
  spinMode     String        @default("immediate")
  shippingRate Float         @default(8.0)
  createdAt    DateTime      @default(now())
  completedAt  DateTime?
  expiresAt    DateTime?
  items       AuctionItem[]
  spots       AuctionSpot[]
}

model AuctionItem {
  id         String        @id @default(cuid())
  auctionId  String
  auction    Auction       @relation(fields: [auctionId], references: [id])
  itemId     String
  item       InventoryItem @relation(fields: [itemId], references: [id])
  quantity   Int           @default(1)
  spotNumber Int?
}

model DailySpin {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  spinDate   String   // "YYYY-MM-DD" UTC date
  spinNumber Int      // global position for that day
  won        Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([userId, spinDate])
}

model SiteSettings {
  id               String   @id @default("main")
  mysteryGiftName  String   @default("Perfect Order Booster Pack")
  mysteryGiftImage String?
  winnerSpinNumber Int      @default(100)
  dailySpinLimit   Int      @default(1)
  wheelSegments      String   @default("[]")
  mysteryWheelTheme  String   @default("cosmic")
  customWheelTheme   String   @default("{}")
  customMysteryColor String   @default("#7C3AED")
  wordSearchEnabled  Boolean  @default(true)
  updatedAt          DateTime @updatedAt
}

model WordSearchCompletion {
  id        String   @id @default(cuid())
  userId    String
  date      String   // "YYYY-MM-DD" Central time
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, date])
  @@index([date])
}

model SupportMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  status    String   @default("open")
  createdAt DateTime @default(now())
}

model PageView {
  id        String   @id @default(cuid())
  path      String
  referrer  String?
  createdAt DateTime @default(now())

  @@index([path])
  @@index([createdAt])
}

model AuctionSpot {
  id             String   @id @default(cuid())
  auctionId      String
  auction        Auction  @relation(fields: [auctionId], references: [id])
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  spotNumber     Int
  paymentId      String?
  paymentMethod  String?
  paid           Boolean  @default(false)
  assignedItemId    String?
  shipped           Boolean  @default(false)
  trackingNumber    String?
  shippingPaid      Boolean  @default(false)
  shippingPaymentId String?
  shippingCost      Float?
  createdAt         DateTime @default(now())
}

model Coupon {
  id        String       @id @default(cuid())
  code      String       @unique
  type      String       // "percent" | "fixed"
  value     Float        // percent 0-100 or fixed dollar amount
  minOrder  Float        @default(0)
  maxUses   Int?         // null = unlimited
  usedCount Int          @default(0)
  expiresAt DateTime?
  active    Boolean      @default(true)
  createdAt DateTime     @default(now())
  orders    StoreOrder[]
}

model StoreOrder {
  id             String           @id @default(cuid())
  userId         String
  user           User             @relation(fields: [userId], references: [id])
  status         String           @default("pending") // pending, paid, shipped, cancelled
  subtotal       Float
  discount       Float            @default(0)
  total          Float
  couponId       String?
  coupon         Coupon?          @relation(fields: [couponId], references: [id])
  paymentId      String?
  paymentMethod  String?
  shippingName   String?
  shippingAddr   String?
  trackingNumber String?
  shipped        Boolean          @default(false)
  createdAt      DateTime         @default(now())
  items          StoreOrderItem[]
}

model StoreOrderItem {
  id        String        @id @default(cuid())
  orderId   String
  order     StoreOrder    @relation(fields: [orderId], references: [id])
  itemId    String
  item      InventoryItem @relation(fields: [itemId], references: [id])
  quantity  Int
  priceEach Float
}

model PokeFlapScore {
  id          String   @id @default(cuid())
  playerName  String
  score       Int
  pokemonName String
  pokemonImg  String
  createdAt   DateTime @default(now())

  @@index([score])
}
