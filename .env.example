# Copy this to .env.local for local dev, or add to Vercel Environment Variables

# PostgreSQL database (get a free one at https://neon.tech)
# Format: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# NextAuth (generate secret with: openssl rand -base64 32)
NEXTAUTH_SECRET="your-secret-here"
NEXTAUTH_URL="https://your-domain.vercel.app"

# Stripe (from https://dashboard.stripe.com → API keys)
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# PayPal (from https://developer.paypal.com)
NEXT_PUBLIC_PAYPAL_CLIENT_ID=""

# Email (optional - for winner notifications, use Gmail App Password)
EMAIL_SERVER_HOST="smtp.gmail.com"
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""
EMAIL_FROM="noreply@pokeauction.com"

# Payment handles shown to Venmo/CashApp users
NEXT_PUBLIC_VENMO_HANDLE="@YourVenmoHandle"
NEXT_PUBLIC_CASHAPP_HANDLE="$YourCashAppTag"

# USPS (from https://developers.usps.com → register an app)
USPS_CONSUMER_KEY=""
USPS_CONSUMER_SECRET=""
# From your USPS account — CRID and MID are shown in your developer portal / OAuth token
USPS_CRID=""
USPS_MID=""
# EPS account number from USPS Enterprise Payment System (for paying postage)
USPS_EPS_ACCOUNT=""
# Set to "testing" to use USPS sandbox
USPS_ENV="production"
# Shipper address (defaults to St Charles, MO — update to your address)
USPS_SHIPPER_FIRSTNAME="POKE"
USPS_SHIPPER_LASTNAME="AUCTION"
USPS_SHIPPER_ADDRESS="7101 Fountainview Circle"
USPS_SHIPPER_CITY="St Charles"
USPS_SHIPPER_STATE="MO"
USPS_SHIPPER_ZIP="63303"

# Site URL
NEXT_PUBLIC_SITE_URL="https://your-domain.vercel.app"
